# Dependencies — restore with `npm install`
node_modules/

# Build output — every artefact here is regenerated by
#   npm run build      html, pdf, 2x page proofs
#   npm run press      + the bleed sheet with crop marks
build/class-*/
build/_*/

# PDFs — every one is a build artefact or a source kept for reference
*.pdf
*.PDF

# Scratch
*.tmp
.guard.tmp

# Cover artefacts — regenerated by `node build/cover.mjs`
build/covers/

# Reference reconstruction output and local extraction intermediates
build/reference/
tmp/
output/
assets/food-reference/originals/
**/__pycache__/

# Source textbooks — NCERT PDFs marked "not to be republished". Kept locally for reference only.
assets/sources/
